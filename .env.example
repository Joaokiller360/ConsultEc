# ── Antecedentes penales por convenio (DINARDAP / Ministerio del Interior) ──
# Déjalas vacías para usar el modo manual (portal oficial + lectura del PDF).
MDI_API_URL=
MDI_API_KEY=
# Motivo institucional declarado en el convenio (obligatorio si el convenio está activo)
MDI_MOTIVO=consulta_antecedentes_penales
# Opcionales
MDI_API_METHOD=POST
MDI_API_AUTH_HEADER=Authorization
MDI_API_AUTH_SCHEME=Bearer
MDI_API_TIMEOUT_MS=20000
MDI_AUDIT_LOG=logs/auditoria-antecedentes.jsonl

# ── Documentos societarios por convenio (Superintendencia de Compañías) ──
SUPERCIAS_API_URL=
SUPERCIAS_API_KEY=
# Opcionales
SUPERCIAS_API_METHOD=POST
SUPERCIAS_API_AUTH_HEADER=Authorization
SUPERCIAS_API_AUTH_SCHEME=Bearer
SUPERCIAS_API_TIMEOUT_MS=20000
SUPERCIAS_AUDIT_LOG=


# ── Despliegue (Docker + Caddy) ──
# Dominio público para Caddy (HTTPS automático con Let's Encrypt)
DOMAIN=consulta.midominio.com
# 1 = confiar en X-Forwarded-For (solo detrás de Caddy/Nginx y sin exponer el puerto 4321)
TRUST_PROXY=1
# Peticiones por minuto y por IP a /api/consulta (cada búsqueda de persona usa ~9)
RATE_LIMIT_PER_MIN=40
# Ruta de la base de datos abierta de la Supercias dentro del contenedor
SUPERCIAS_DB=/app/data/supercias.db
